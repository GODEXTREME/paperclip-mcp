# paperclip-mcp configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Required — Base URL of your Paperclip instance.
# Default (local install): http://localhost:3100/api
# Change only if you have a remote or differently configured Paperclip instance.
PAPERCLIP_BASE_URL=http://localhost:3100/api

# Required — Agent API key.
# Generate in Paperclip UI: Settings → API Keys → New Key.
# Keep this secret: it grants write access to your company's data.
PAPERCLIP_API_KEY=

# Required — Company UUID to operate on.
# Find it in the Paperclip UI URL when viewing your company:
#   http://localhost:3100/companies/{PAPERCLIP_COMPANY_ID}
PAPERCLIP_COMPANY_ID=

# Required for HTTP transports (streamable-http/sse) — bearer token that MCP
# clients must send as "Authorization: Bearer <token>". The server refuses to
# start over HTTP without it. Not needed for --transport stdio.
# Generate with:
#   openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional — public HTTPS base URL of this server. Required only when accessing
# from Claude.ai web, which uses OAuth 2.0 instead of a static bearer token.
# When set, the server exposes an OAuth discovery endpoint and accepts both OAuth
# (Claude.ai web) and static bearer tokens (CLI / Claude Desktop).
# Example: https://paperclip-mcp.yourdomain.com
# OAuth client_id to use in Claude.ai connector: paperclip-mcp-client
# OAuth client_secret to use in Claude.ai connector: (same as MCP_AUTH_TOKEN above)
MCP_PUBLIC_URL=
